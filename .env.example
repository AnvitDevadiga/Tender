# Optional provider credentials. Leave blank for tests and offline development.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional OpenAI-compatible provider (OpenAI, OpenRouter, vLLM, Ollama, ...).
# Select it with model IDs such as "openai/gpt-4o-mini".
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GITHUB_TOKEN=

# Optional human-review gate; generate a private random value with at least 32 characters.
TENDER_APPROVAL_TOKEN=

# Optional bearer token for mutating API routes. When unset, local development
# stays open, so keep the API bound to loopback; when set, run creation and
# cancellation require it.
TENDER_API_TOKEN=

# Local persistence and the allowed workspace root for API Docker workflows.
TENDER_DB_PATH=tender.db
TENDER_WORKSPACE_ROOT=/absolute/path/to/trusted/workspaces
TENDER_ARTIFACT_ROOT=artifacts

# Request-size cap and worker tuning.
TENDER_MAX_REQUEST_BYTES=1048576
TENDER_WORKER_POLL_SECONDS=1
TENDER_WORKER_LEASE_SECONDS=90
TENDER_WORKER_RECOVERY_SECONDS=15

# Optional in-process throttle for mutating API routes (POST/PUT/PATCH/DELETE).
# 0 or unset disables it. Buckets are per client host and per worker process,
# so a distributed deployment still needs shared quotas.
TENDER_RATE_LIMIT_PER_MINUTE=0
TENDER_RATE_LIMIT_BURST=10
